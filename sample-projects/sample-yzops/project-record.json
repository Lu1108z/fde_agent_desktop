          "sourceTableFields": "hrp.v_dept_cost(drug_income_ex_herb, medical_income)",
          "sql": "SELECT SUM(drug_income_ex_herb) / SUM(medical_income) FROM sdr.ads_dept_cost WHERE ym = :ym",
          "exampleValue": "2026-05：26.3%",
