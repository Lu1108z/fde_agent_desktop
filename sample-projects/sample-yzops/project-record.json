          "calculation": "出院者占用总床日 ÷ 出院人次",
          "sourceTableFields": "cdr.v_discharge(los_days)",
          "sql": "SELECT AVG(los_days) FROM cdr.v_discharge WHERE transfer_flag = 0 AND discharge_date BETWEEN :s AND :e",
          "exampleValue": "2026-05：7.3 天",
          "owner": "运营管理部 陈立文"
        },
