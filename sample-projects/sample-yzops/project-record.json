          ],
          "calculation": "出院患者住院总费用 ÷ 出院人次",
          "sourceTableFields": "cdr.v_inp_fee(total_fee)",
          "sql": "SELECT SUM(f.total_fee) / COUNT(DISTINCT f.visit_id) FROM cdr.v_inp_fee f JOIN cdr.v_discharge d ON d.visit_id = f.visit_id WHERE d.discharge_date BETWEEN :s AND :e",
          "exampleValue": "2026-05：19,860 元",
          "owner": "运营管理部 陈立文"
        },
