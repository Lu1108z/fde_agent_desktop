          "standardVersion": "",
          "sql": "SELECT d.dept_code, c.ym, c.medical_income, c.drug_income_ex_herb, c.material_income, c.total_cost FROM hrp.v_dept_cost c JOIN sdr.dim_dept d ON d.hrp_dept_id = c.dept_id WHERE c.closed_flag = 1",
