# Dependencies
node_modules/

# Build output
dist/
build/
*.dmg
*.exe
*.blockmap
*.zip

# Local env / secrets (real keys live in ~/.product-lobster/, never in repo)
# NOTE: config-templates/.env is a committed placeholder template, kept on purpose.
/.env
/.env.local
*.local

# License AES secret (symmetric key: encrypts AND decrypts .lic — never commit).
# Kept on disk for local dev/build; packaged into the app via extraResources.
# public_key.pem is safe to distribute and is tracked on purpose.
src/main/license/keys/aes.key

# Android release signing — keystore + passwords never go in the repo.
android/release.keystore
android/keystore.properties
android/local.properties

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Python (in case of colocated backend artifacts)
__pycache__/
*.pyc
.venv/

# Local distribution build cache
.local-release/
.local-update/

# Local validation artifacts and recipient data
/tasks/
/发布包/
/.product-lobster/
/.env.*
*.lic
*.sqlite
*.sqlite3
*.db

# 智能体平台站点：由 npm run sync:agent-platform 从 med-ai-demo 代码仓同步，不入库
/med-ai-demo/

# 医疗知识包构建缓存（正文/向量），产物在 med-knowledge/
.med-knowledge-cache/
# 临床知识包构建缓存，产物在 clinical-knowledge/
.clinical-knowledge-cache/
